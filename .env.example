# Copy to .env and adjust. All settings are optional.

# Exact filename of the script to load from pdfs/ — a PromptDesk .pcy export
# or a PDF or DOCX. Only needed when pdfs/ contains more than one script.
SCRIPT_FILE=

# Legacy alternative to SCRIPT_FILE for a plain PDF or DOCX.
PDF_FILE=

# Optional camera feed shown on Control.
# image = direct MJPEG stream, embed = embeddable player page.
CAMERA_URL=
CAMERA_MODE=image
